# -----------------------------------
# 数据目录（保留目录结构，忽略内容）
# -----------------------------------
# 数据库文件
data/*.db
data/*.db-shm
data/*.db-wal

# 密钥文件
data/.secret_key

# 115 网盘客户端缓存（含 pickcode/userkey 等敏感数据）
data/p115-home/

# 日志文件
data/logs/

# 但保留 data 目录
!data/.gitkeep

# -----------------------------------
# 项目特定
# -----------------------------------
# 根目录密钥（如果存在）
.secret_key

# 环境变量文件
.env
.env.local
.env.*.local

# 日志文件
*.log
logs/

# 调试/临时脚本（开发时用，不应提交）
_debug_*.py
_debug_*.js
_tmp_*

# 115 网盘凭据/缓存（高危：含 cookies/pickcode/userkey）
*.p115client
p115client.cache/
.p115client/
115_cookies.txt

# -----------------------------------
# AI/开发工具工作目录
# -----------------------------------
.serena/
.spec-workflow/

# AI 上下文文档（ARCHITECTURE.md 是正式文档，必须入库）
CLAUDE.md
**/CLAUDE.md
.claude/
docs/

# BMad 敏捷工作流文档
.bmad/

